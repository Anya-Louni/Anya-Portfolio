# Copy to .env.local and fill in from your Supabase project settings ▸ API.
# Without these, Notes falls back to this browser's localStorage and visits
# are not counted at all. Fine for development; stores nothing across visitors.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The absolute address, used for the canonical link and the social card.
# It already defaults to the live site, so this is only for a fork.
# VITE_SITE_URL=https://osnya.netlify.app/

# Only for a host that serves the site from a subfolder, such as a GitHub
# project page. Netlify serves from the root and needs nothing here.
# VITE_BASE=/Anya-Portfolio/
