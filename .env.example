# Copy to .env.local and fill in from your Supabase project settings ▸ API.
# Without these the guestbook falls back to this browser's localStorage,
# which is fine for development but stores nothing across visitors.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
